# lotus-mcp environment.
#
# Contains no secrets and needs none: the adapter has no accounts, tokens or
# outbound calls. Only paths and log level are settable here — privacy settings
# are deliberately NOT env-overridable, so loosening consent requires editing a
# mounted, reviewable config file.

# Path to config.yaml inside the container.
LOTUS_CONFIG=/app/config/config.yaml

# Base directory for the SQLite database and operational state.
LOTUS_DATA_DIR=/app/data

# Base directory holding incoming/, processed/ and failed/.
LOTUS_IMPORT_ROOT=/app/imports

# DEBUG | INFO | WARNING | ERROR. Logs go to stderr and never contain note text.
LOTUS_LOG_LEVEL=INFO

# ---- host-side settings used by compose.yaml ----
# On ZimaOS the app data directory is commonly /DATA/AppData; other NAS
# platforms use /mnt/user/appdata or /volume1/docker. Set whatever is real for
# your box — nothing here is hardcoded.
LOTUS_HOST_DIR=/DATA/AppData/lotus-mcp

# UID/GID that owns the host directories above. Must match, or the container
# cannot write the database. `id -u` / `id -g` on the host.
LOTUS_UID=1000
LOTUS_GID=1000
