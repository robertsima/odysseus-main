#!/usr/bin/env python3
"""Agamemnon command dispatcher.

Usage: python scripts/agamemnon <command> [arguments]
The installed odysseus-* entrypoints remain upgrade aliases. New automation
should use this dispatcher; it runs the same implementation and data paths.
"""
from pathlib import Path
import os
import sys

ROOT = Path(__file__).resolve().parent


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    commands = sorted(p.name.removeprefix('odysseus-') for p in ROOT.glob('odysseus-*')
                      if p.is_file() and os.access(p, os.X_OK) and '.' not in p.name)
    if not args or args in (['help'], ['--help'], ['-h']):
        print('Agamemnon 0.1.0\nUsage: agamemnon <command> [arguments]\n')
        print('\n'.join('  ' + command for command in commands))
        return 0
    if args in (['--version'], ['-v']):
        print('Agamemnon 0.1.0')
        return 0
    if args[0] == 'help' and len(args) == 2:
        args = [args[1], '--help']
    if args[0] not in commands:
        print(f'Agamemnon: unknown command {args[0]!r}', file=sys.stderr)
        return 1
    python = ROOT.parent / 'venv' / 'bin' / 'python'
    interpreter = str(python) if python.exists() else sys.executable
    os.execv(interpreter, [interpreter, str(ROOT / ('odysseus-' + args[0])), *args[1:]])
    return 0


if __name__ == '__main__':
    sys.exit(main())
