# Odysseus UI — Environment Configuration
# Copy this file to .env and fill in your values.
#
# This file holds PLACEMENT only: secrets, mount paths, ports, service URLs,
# and deployment-level trust decisions — the things that change because THIS
# install happens to run on THIS box. Preferences (models, limits, cadences,
# anything you'd tune by taste rather than by host) live in the app's
# Settings UI instead, backed by data/settings.json. See
# docs/configuration.md for the full rule and the inventory behind it.

# ============================================================
# LLM Configuration
# ============================================================

# Primary LLM host (default: localhost)
LLM_HOST=localhost

# Additional LLM hosts, comma-separated (for model discovery)
# Use hostnames/IPs only; Odysseus scans common serve ports, including Ollama's 11434.
# LLM_HOSTS=llm-host.local,backup-llm.local

# Optional Ollama base URL. In Docker, host Ollama is usually reachable here
# when started with OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional LM Studio URL. In Docker, host LM Studio is reachable here
# when LM Studio is set to serve on all interfaces (0.0.0.0).
# LM_STUDIO_URL=http://host.docker.internal:1234

# OpenAI API key (only needed if using OpenAI models).
# Do not commit real keys. Keep this commented until needed.
# OPENAI_API_KEY=your_openai_api_key_here

# Todoist API token (only needed for the built-in Todoist MCP integration).
# Do not commit real tokens. Keep this commented until needed.
# TODOIST_API_TOKEN=your_todoist_api_token_here

# Lotus is local-only and needs no token. Its SQLite database and import
# folders live under APP_DATA_DIR/lotus in Docker (data/lotus by default).
# Copy lotus-mcp/config/config.example.yaml to data/lotus/config.yaml when you
# want to change its conservative privacy defaults.
# LOTUS_LOG_LEVEL=INFO

# Speech-to-text hardware placement. The right device, quantization, and
# concurrency are mostly facts about THIS host's available CPU/GPU, so they
# live here rather than in Settings. Everything else about STT (enabled,
# provider, model, beam size, audio limits) is a Settings UI choice.
# ODYSSEUS_STT_DEVICE=cpu
# ODYSSEUS_STT_COMPUTE_TYPE=int8
# ODYSSEUS_STT_CONCURRENCY=1

# Research service LLM endpoint
# RESEARCH_LLM_ENDPOINT=http://localhost:8000/v1/chat/completions

# Extra CA bundle for LLM providers whose TLS chain isn't in the default
# trust store. Layered ON TOP of the system / certifi bundle — verification
# stays on for every host, the trust set just gets larger. Useful for:
#   - GigaChat / Sber (Russian Trusted Root CA): without this the endpoint
#     shows offline with CERTIFICATE_VERIFY_FAILED — self-signed certificate
#     in certificate chain.
#   - On-premise / corporate LLM gateways with an internal CA.
# Point at a PEM file containing the missing root(s).
# LLM_CA_BUNDLE=/etc/odysseus/ca/extra-roots.pem

# ============================================================
# Search & Web
# ============================================================

# SearXNG instance URL (self-hosted, for web search).
# Docker Compose overrides this to http://searxng:8080 for in-network access.
SEARXNG_INSTANCE=http://localhost:8080

# Optional SearXNG cookie/CSRF secret. If blank, Docker generates one on first boot
# and stores it in the searxng-data volume.
# SEARXNG_SECRET=

# ============================================================
# Database
# ============================================================

# SQLite database path (default: sqlite:///./data/app.db)
# DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# Data directory
# ============================================================
# Move everything that lives under data/ - settings, sessions, database, auth,
# cache, uploads, etc. - to another path:
# ODYSSEUS_DATA_DIR=C:\path\to\dir

# Move just the mail-attachments store off the data dir (e.g. onto a bigger
# or slower disk). Defaults under ODYSSEUS_DATA_DIR/mail-attachments.
# ODYSSEUS_MAIL_ATTACHMENTS_DIR=/mnt/bulk/odysseus-mail-attachments

# ============================================================
# Auth & Security
# ============================================================

# Enable authentication (default: true)
# AUTH_ENABLED=true

# Host bind address and port for the Odysseus web UI in Docker Compose.
# Keep APP_BIND on loopback unless you intentionally want LAN/reverse-proxy access.
# APP_BIND=127.0.0.1
# Change this if another local service already uses 7000 (macOS AirPlay often does).
# APP_PORT=7000

# Optional HTTP address advertised in companion/mobile pairing codes. Set this
# when Docker would otherwise advertise a container address or loopback. Use a
# LAN or Tailscale IPv4 address, a single-label hostname, or an mDNS *.local
# name that the phone can reach. HTTPS and public hostnames are not supported
# by the current companion client. Do not include credentials, a path, query,
# or fragment.
# COMPANION_BASE_URL=http://192.168.1.50:7000

# Development-only auth bypass for loopback requests.
# Keep false for Docker, LAN, reverse proxy, and any shared deployment.
# LOCALHOST_BYPASS=false

# Mark session cookies Secure. Left unset, this follows the request scheme:
# an HTTPS login gets a Secure cookie, a plain-HTTP one does not. Set true to
# force it on, or false to force it off while you still serve plain HTTP.
# Upgrading: this used to default to false. Drop a leftover SECURE_COOKIES=false
# from your .env unless you still need that escape hatch — it keeps HTTPS logins
# on a non-Secure cookie.
# SECURE_COOKIES=true

# Optional: pre-seed the first admin password during setup.
# Do not commit a real password.
# ODYSSEUS_ADMIN_PASSWORD=change_me_before_first_boot

# CORS allowed origins (default: localhost-only; restrict to your public origin in production)
# ALLOWED_ORIGINS=http://localhost:7000,http://localhost:8000

# Single-user vs. multi-user install. Single-user (default) skips identity
# resolution for unauthenticated requests and falls back to the address
# below. Set to 0 for a real multi-user install so unauthenticated requests
# are rejected instead of silently attributed to a placeholder owner.
# ODYSSEUS_SINGLE_USER=1
# ODYSSEUS_FALLBACK_OWNER=owner@localhost

# Internal API token Odysseus uses to call its own routes (e.g. from
# scheduled tasks). Auto-generated at startup if unset; pin it only if you
# need it stable across restarts.
# ODYSSEUS_INTERNAL_TOKEN=
# Override the base URL Odysseus uses for those internal calls — needed
# behind a TLS-terminating reverse proxy that changes the effective host.
# ODYSSEUS_INTERNAL_BASE=https://your-proxy-host

# ============================================================
# ChromaDB (vector store)
# ============================================================

# ChromaDB service host.
# Manual host run: localhost:8100 when using `docker run -p 8100:8000 chromadb/chroma`.
# Docker Compose overrides these to chromadb:8000 for in-network access.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Docker Compose host-port bind addresses for bundled services.
# Defaults are loopback-only for safety. To expose ntfy only on Tailscale,
# set NTFY_BIND to your host's Tailscale IP and update NTFY_BASE_URL.
# CHROMADB_BIND=127.0.0.1
# NTFY_BIND=127.0.0.1
# NTFY_BASE_URL=http://localhost:8091
# Example:
# NTFY_BIND=100.x.y.z
# NTFY_BASE_URL=http://100.x.y.z:8091

# ============================================================
# RAG / Embeddings
# ============================================================

# NOT CURRENTLY CONSULTED. Retrieval embeds with local FastEmbed only:
# build_embedding_lanes() returns a single `fastembed` lane and
# get_embedding_client() returns the local client, so none of the three
# variables below change what fills a Chroma collection. They are kept for the
# settings panel that still writes them and for a future remote lane.
#
# Embedding API endpoint (OpenAI-compatible /v1/embeddings)
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Embedding API key (if there's one)
# EMBEDDING_API_KEY=embedding_api_key_here

# Embedding model name (must be available at the endpoint above)
# EMBEDDING_MODEL=all-minilm:l6-v2

# The embedding model. Uses fastembed (ONNX) — downloads on first run (~50MB)
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=  # defaults to ~/.cache/fastembed

# ChromaDB is the vector STORE; the embedder above is what fills it. They are
# layers, not alternatives — turning one off does not select the other.
# Vectors from different models cannot share a Chroma collection, so a
# collection is named for the embedder that filled it (a "lane"). There is one
# supported lane, `fastembed`. ODYSSEUS_FASTEMBED_LANE is still read by
# src/embedding_lanes.fastembed_lane_mode() but no longer changes which lanes
# are built; see docs/vault-retrieval.md.

# ---- Agent file access ----
# Extra directories the agent's file tools (read_file / write_file / edit_file /
# grep / glob / ls) may touch, beyond the data dir and the temp dirs. Separate
# with the platform path separator or commas. Declared here rather than through
# the settings API so a bind mount and the permission to use it arrive together.
# The sensitive-name deny list (.ssh, .gnupg, id_rsa, ...) still applies inside
# every root, and a directory labelled `private` below stays closed regardless.
# ODYSSEUS_TOOL_EXTRA_ROOTS=/app/workspace

# Vault/knowledge-base trees to index at boot, as `path:label` pairs relative to
# <data>/personal_docs. WITHOUT this the directories come up unindexed and
# UNLABELLED on a fresh install — and an unlabelled directory is a PUBLIC
# directory, readable by hosted models and by read_file. The label, not a :ro
# mount, is what closes a private tree.
# ODYSSEUS_PERSONAL_DIRS=Vault Mind:public,AI Mind:public,Journal:private

# Retrieval ranking (recency weighting, chunk caps, tag credit, date-order
# parsing) is tuned from Settings now, not the environment — see
# docs/configuration.md if you're looking for the old ODYSSEUS_RAG_* /
# ODYSSEUS_VAULT_DATE_ORDER / RAG_SIMILARITY_THRESHOLD variables.

# ---- Agent worktree and gated publishing ----
# The agent works in a persistent git worktree on an agent/odysseus/* branch and
# can open a DRAFT pull request — but only after a human approves that exact
# commit from the host. Full guide: docs/agent-worktree.md
#
# Master switch. Without it the agent can still create a worktree, edit, test and
# commit; it simply cannot push. Everything below is inert until this is set.
# ODYSSEUS_AGENT_PUBLISH_ENABLED=1
#
# The one repository the agent may push to, as owner/name. The push URL is
# derived from this value; there is deliberately no setting for a different host.
# ODYSSEUS_AGENT_REPO=your-org/your-repo
#
# Where worktrees and approval state live. Defaults sit under the data dir.
# ODYSSEUS_AGENT_WORKTREE_ROOT=/app/data/agent_worktrees
# ODYSSEUS_AGENT_STATE_DIR=/app/data/agent_worktree
#
# Repository the worktrees are created from. REQUIRED in a container: the image
# has no .git directory, so the default (the app root) is not a checkout. Point
# this at the checkout inside the data mount that the agent actually works in.
# ODYSSEUS_AGENT_SOURCE_REPO=/app/data/development/odysseus-main
#
# The shell tool refuses `git push` and `gh pr create`, because neither can
# authenticate there, and tells the agent to use manage_agent_worktree instead.
# Set this only if you have your own credential setup in the container.
# ODYSSEUS_AGENT_ALLOW_BASH_PUSH=1
#
# Same escape hatch for a bare `claude` shell invocation, which otherwise gets
# redirected to the delegate_to_claude_code tool.
# ODYSSEUS_AGENT_ALLOW_BASH_CLAUDE=1
#
# The base branch and approval TTL are Settings-UI choices now (agent_base_branch,
# agent_approval_ttl_seconds) — see docs/configuration.md.
#
# ── Claude Code delegation (delegate_to_claude_code, /api/claude-code/*) ──
# Every value below can also be set in Settings > Tools > Claude Code, which
# wins over the environment and needs no restart. Claude Code signs in with
# your own Claude account or ANTHROPIC_API_KEY as the container user; Odysseus
# never reads or stores those credentials. See integrations/claude/README.md.
# CLAUDE_CODE_BINARY=/app/data/claude-code/bin/claude
# HOME for the Claude process (its login lives under $CLAUDE_CODE_HOME/.claude).
# CLAUDE_CODE_HOME=/app/data
# Directories whose checkouts (at or one level below) may be delegated to.
# CLAUDE_CODE_REPOSITORY_ROOTS=/app/data/development:/app/data/agent_worktrees
# Used when a delegation names no repository (else: ODYSSEUS_AGENT_SOURCE_REPO,
# the active workspace, or the only approved checkout).
# CLAUDE_CODE_DEFAULT_REPOSITORY=/app/data/development/odysseus-main
# CLAUDE_CODE_MAX_CONCURRENT_TASKS=2
# Let a delegated Claude session call back into this Odysseus (scoped Claude
# Agent token in a private 0600 file; passed only in the child's environment).
# CLAUDE_CODE_ODYSSEUS_URL=http://127.0.0.1:7000
# CLAUDE_CODE_ODYSSEUS_TOKEN_FILE=/app/data/claude-agent.token
#
# Preferred credential: a GitHub App installed on that one repository, with
# Contents: write and Pull requests: write. Odysseus mints a one-hour
# installation token per operation and keeps it in memory only. Keep the key
# file at mode 600 and owned by the service account.
# ODYSSEUS_GITHUB_APP_ID=123456
# ODYSSEUS_GITHUB_APP_INSTALLATION_ID=87654321
# In a container the key must sit inside a mounted volume, so use the data mount
# (/app/data) rather than a host-only path such as /etc/odysseus. The agent's
# file tools refuse to open private key material, so this location is safe.
# ODYSSEUS_GITHUB_APP_PRIVATE_KEY_PATH=/app/data/github-app.pem
# Override the GitHub API base for GitHub Enterprise Server.
# ODYSSEUS_GITHUB_API_BASE=https://api.github.com
#
# Fallback only. A fine-grained PAT scoped to the one repository. Long-lived, so
# rotate it; Odysseus warns on every use.
# ODYSSEUS_AGENT_GITHUB_TOKEN=
#
# Not sure whether these are right? Run the doctor; it asks GitHub and names the
# exact mistake, including the correct installation id:
#   docker exec -it odysseus python scripts/odysseus-agent-worktree doctor

# ============================================================
# Odysseus API callback (scripts and integrations that call back in)
# ============================================================
# Used by integrations/claude and integrations/codex skill scripts, and by
# any delegated child process, to reach this running instance and authenticate
# to it. Odysseus sets both when it spawns a delegate; set them yourself only
# for a manual/standalone script run.
# ODYSSEUS_URL=http://127.0.0.1:7000
# ODYSSEUS_API_TOKEN=

# ============================================================
# Google OAuth2 (Google Workspace / .edu email accounts, Google Calendar)
# ============================================================
# Required to use the "Connect with Google" OAuth flow in email account setup,
# and/or the "Connect Google Calendar" button in Calendar integrations. Google
# requires OAuth 2.0 for both Gmail (Workspace/.edu) and Calendar — Calendar's
# CalDAV endpoint flatly rejects username/password, unlike IMAP/SMTP app
# passwords, which is why plain Gmail CalDAV never worked. The same client
# credentials cover both flows; each has its own redirect URI and scope.
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
#   1. Enable the Gmail API and/or the Google Calendar API for your project,
#      matching whichever flow(s) you'll use.
#   2. Configure the OAuth consent screen (User Type: Internal for Workspace orgs).
#      Add scopes: https://mail.google.com/, email, and/or
#      https://www.googleapis.com/auth/calendar.
#   3. Create an OAuth 2.0 Client ID (type: Web application).
#      Add both redirect URIs you intend to use:
#        http://localhost:7000/api/email/oauth/google/callback
#        http://localhost:7000/api/calendar/oauth/google/callback
#      (replace host/port for hosted installs — Google requires an exact match).
#   4. Copy the Client ID and Client Secret below.
#
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=replace-with-client-secret
#
# Set these explicitly for HTTPS, reverse-proxy, or hosted deployments. Each
# value must exactly match an authorized redirect URI in the Google client.
# Local HTTP setups may leave both unset — the callback URL is inferred from
# the incoming request's Host header.
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/email/oauth/google/callback
# GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=https://your-domain.com/api/calendar/oauth/google/callback

# CalDAV normally refuses to connect to private/internal IPs (SSRF guard).
# Set this only if your CalDAV server is genuinely on your own LAN/NAS.
# ODYSSEUS_ALLOW_PRIVATE_CALDAV=0

# ============================================================
# GitHub Copilot (optional Copilot Chat provider)
# ============================================================
# These identify the client to GitHub's Copilot API and rarely need to change.
# Override only if GitHub changes the protocol contract, or you register your
# own allow-listed GitHub OAuth App for a fork of this project.
# ODYSSEUS_COPILOT_CLIENT_ID=01ab8ac9400c4e429b23
# ODYSSEUS_COPILOT_API_VERSION=2026-06-01
# ODYSSEUS_COPILOT_USER_AGENT=Odysseus/1.0
# ODYSSEUS_COPILOT_INTEGRATION_ID=vscode-chat
# ODYSSEUS_COPILOT_EDITOR_VERSION=Odysseus/1.0

# Origin the MCP OAuth callback is sent back to, for remote (Streamable HTTP)
# MCP servers that register it dynamically. Defaults to http://localhost:$APP_PORT,
# which is right only when you reach Odysseus directly on that port. Set it for
# HTTPS, reverse-proxy, hosted, and Docker installs — inside the container the
# app always listens on 7000 and cannot see the host port map, so the default is
# wrong there whenever APP_PORT is not 7000.
#
# Not for Google MCP servers. Those use Desktop App credentials, and Google only
# accepts loopback redirect URIs for that client type, so a public origin here is
# rejected with redirect_uri_mismatch. Leave it unset for a Google-only install:
# the loopback default is what Google wants, and remote users finish through the
# paste-back page, which never has to load the redirect.
# https://developers.google.com/identity/protocols/oauth2/native-app
# OAUTH_REDIRECT_BASE_URL=https://your-domain.com

# ============================================================
# Misc
# ============================================================

# Cleanup cadence is a Settings UI choice; it is intentionally not part of
# deployment environment configuration.

# In-process email pollers (default: on). Set to 0 if you're driving
# polling from cron / systemd via `scripts/odysseus-mail poll-scheduled`
# and `scripts/odysseus-mail poll-summary`, otherwise both schedulers
# race on the same SQLite.
# ODYSSEUS_INPROCESS_POLLERS=1

# In-process scheduled-task runner (default: on). Set to 0 to let an
# external driver fire scheduled tasks. Calendar reminders are
# frontend-driven (polling /api/notes from the browser) so no gate is
# needed there.
# ODYSSEUS_INPROCESS_TASKS=1

# Host used by the built-in "run_script" scheduled-task action.
# Empty/local/localhost runs scripts on the app host. Set to an SSH host alias
# if you intentionally want scheduled scripts to run remotely.
# ODYSSEUS_SCRIPT_HOST=localhost

# Upload/import size caps (chat attachments, gallery images, memory import,
# personal documents, email attachments, STT audio, .ics files, TTS cache) are
# Settings-UI choices now — see docs/configuration.md. They used to be
# ODYSSEUS_*_MAX_BYTES environment variables; those are still read as a
# fallback default for installs that already set them.

# Windows-only: `ollama list` is skipped by default during Cookbook model
# scanning because of past blocking-call issues. Opt back in if you need
# CLI-based Ollama detection on Windows.
# ODYSSEUS_ALLOW_OLLAMA_CLI_SCAN=1

# ============================================================
# Built-in MCP servers (general)
# ============================================================
# Global kill switch if the MCP subprocess model doesn't work in your
# environment (e.g. a locked-down sandbox).
# ODYSSEUS_DISABLE_MCP=0

# Extra shell commands allowed as stdio MCP servers, comma-separated. Empty by
# default — only add a command here if you trust it, since anything listed
# runs as a subprocess of Odysseus.
# ODYSSEUS_MCP_ALLOWED_COMMANDS=

# Built-in browser automation (Playwright MCP). Auto-detects Chrome/Chromium;
# override only if it's installed somewhere non-standard, or to change the
# sandbox/cache behavior for this host's container runtime.
# ODYSSEUS_BROWSER_EXECUTABLE=/usr/bin/chromium
# ODYSSEUS_BROWSER_NO_SANDBOX=1
# ODYSSEUS_BROWSER_MCP_CACHE=/app/data/local/playwright-mcp-cache
# Locked-down/offline installs: refuse to `npx install` the browser package
# at startup unless it's already cached.
# ODYSSEUS_BROWSER_MCP_REQUIRE_CACHE=0

# ============================================================
# Host Docker access (explicit opt-in)
# ============================================================
# Default Docker Compose does not mount /var/run/docker.sock. Existing
# Ollama, vLLM, and other OpenAI-compatible endpoints remain usable without it.
#
# Enable this only for intentional Cookbook/local Docker-daemon management.
# Raw socket access is high-trust and can grant broad control over the host
# Docker daemon. DOCKER_GID is REQUIRED once this overlay is enabled — there
# is no default, because the host docker group's GID varies by distro.
# Find yours with: getent group docker | cut -d: -f3
# Put these values in .env, or export them before running docker compose.
# COMPOSE_FILE=docker-compose.yml:docker/host-docker.yml
# DOCKER_GID=999
# docker/host-docker.yml sets this inside the container. Keep it paired
# with the socket overlay; setting it alone is not sufficient.
# ODYSSEUS_ENABLE_HOST_DOCKER=true

# ============================================================
# Windows Pi worker (optional built-in MCP tool)
# ============================================================
# Runs Pi and its file/shell tools on an optional Windows workspace over SSH.
# These values are intentionally unset by default; there is no assumed local
# drive, NAS path, or worker host in the generic install. The SSH
# identity is read from the existing /app/.ssh mount. Add its public key to the
# Windows user's authorized_keys before enabling this endpoint.
# ODYSSEUS_PI_WORKER_HOST=user@192.x.x.x
# ODYSSEUS_PI_WORKER_SCRIPT=C:/path/to/Start-Pi-Worker.ps1
# ODYSSEUS_PI_WORKER_ROOT=C:/path/to/workspace
# ODYSSEUS_PI_WORKER_IDENTITY_FILE=/app/.ssh/id_X
# Default vault path the Pi worker documents against.
# ODYSSEUS_PI_DOCUMENTATION_ROOT=/app/data/personal_docs/AI Mind

# ============================================================
# GitHub (built-in MCP servers)
# ============================================================
# The official github-mcp-server binary is baked into the image and runs as a
# stdio child process of the Odysseus container -- no sibling container, and
# therefore no Docker socket mounted into Odysseus.
#
# Setting a real GitHub token enables "Built-in: GitHub Read": read-only, twelve tools
# (file contents, commits, branches, code search, issues, PRs, Actions logs).
# Leave it unset and no GitHub server is registered at all.
# A value from another service (for example an `ody_` Odysseus API token) is
# rejected at startup so the UI cannot advertise GitHub tools that only return
# 401. Fine-grained or classic PAT; read scopes are enough for the read server.
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
#
# GitHub Enterprise Server / ghe.com only.
# GITHUB_HOST=https://github.example.com
#
# Opt-in write server ("Built-in: GitHub Write"), off unless set to 1. Scoped
# to the collaboration layer: create_pull_request, add_issue_comment,
# pull_request_review_write, add_comment_to_pending_review. Repository-mutating
# tools (push_files, create_or_update_file, delete_repository) are never
# exposed -- the working tree belongs to the Pi worker, which edits files, runs
# tests and drives git over SSH.
# ODYSSEUS_GITHUB_MCP_WRITE=1
# This same opt-in plus a token with repository Contents write permission enables
# the typed manage_git push, force-with-lease, and remote-branch deletion actions.
# Per-agent settings must also allow github_read and/or github_write; environment
# variables cannot override an agent loadout deny. Ensure ODYSSEUS_DISABLE_MCP is
# unset or 0. In CasaOS/ZimaOS, set these on the deployed app/container and
# recreate it; a repository .env file does not change an already-created container.
#
# Point at a github-mcp-server binary elsewhere (native installs; the resolver
# already checks PATH and /usr/local/bin, and finds .exe on Windows).
# ODYSSEUS_GITHUB_MCP_BINARY=/usr/local/bin/github-mcp-server
#
# Host Docker access can be combined with one GPU overlay:
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml:docker/host-docker.yml
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml:docker/host-docker.yml

# ============================================================
# GPU support (Docker Compose)
# ============================================================
# Pass the host GPU into the odysseus container. Default (unset) = CPU.
# COMPOSE_FILE is a native `docker compose` feature: a colon-separated
# list of files merged left-to-right. Pick ONE GPU line below, or leave
# all commented for CPU.
#
# NVIDIA (requires nvidia-container-toolkit + `nvidia-ctk runtime
# configure --runtime=docker` on the host):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
# COMPOSE_FILE=docker-compose.yml;docker/gpu.nvidia.yml    #(Windows)
#
# AMD ROCm (requires ROCm drivers on the host and the GID of the render group):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml
# Find the render GID with: getent group render | cut -d: -f3
# RENDER_GID=989
#
# These overlays only expose the GPU devices. The slim Odysseus image
# still needs CUDA/ROCm userspace via Cookbook -> Dependencies (vLLM,
# llama-cpp-python, etc.) before models can actually serve on GPU.

# ============================================================
# Storage Paths (Docker Compose)
# ============================================================
# Neutral, cross-platform defaults — a relative path next to the compose file.
# ZimaOS/CasaOS installs traditionally use /DATA/AppData/odysseus and
# /DATA/Vault instead; that convention now lives entirely in
# docker-compose.zimaos-local.yml (an explicitly-named overlay), not here.

# APP_DATA_DIR=./data
# APP_LOGS_DIR=./logs
